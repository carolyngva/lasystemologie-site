---
import '../styles/global.css';
import '../styles/design-system.css';

const testimonials = [
  {
    quote: 'Je me suis sentie bien accompagnée, en sécurité. Vous nous faites nous sentir en confiance.',
    author: 'Jennifer',
  },
  {
    quote: "J'ai fait une constellation familiale sans trop savoir à quoi m'attendre. J'y ai compris des choses que je portais depuis longtemps, sans avoir besoin de longues explications.",
    author: 'Sonia',
  },
  {
    quote: "J'ai pu voir l'impact sans avoir fait ma constellation. Je sens que les choses bougent encore de mon côté quelques jours après.",
    author: 'Christian',
  },
];

const formats = [
  {
    title: 'Karma Reset à Genève',
    text: "Des journées de constellations familiales en groupe, au Shanti Club à Genève, pour explorer les répétitions, les transmissions et les places qui traversent les grands thèmes de la vie : amour, argent, famille, travail.",
    cta: 'Découvrir Karma Reset',
    href: '/karma-reset',
  },
  {
    title: 'Constellations en ligne',
    text: 'Un format en groupe, en visio, pour recevoir une constellation familiale avec le soutien de représentant·es, depuis le confort de chez soi.',
    cta: 'Réserver une constellation en ligne',
    href: '/constellation-en-ligne',
  },
  {
    title: "Constellations sur l'eau",
    text: "Un format individuel en visio avec Caroline ou Eloa, où l'eau devient support de représentation pour rendre visibles les mouvements, tensions et rapprochements d'un système.",
    cta: "Découvrir les constellations sur l'eau",
    href: '/constellations-sur-leau',
  },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Constellations familiales et systémiques | Systémologie</title>
    <meta
      name="description"
      content="Systémologie propose des constellations familiales et systémiques dans un cadre clair, profond et humain, à Genève, en ligne et avec le support de l'eau."
    />
    <link rel="canonical" href="https://lasystemologie.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Constellations familiales et systémiques | Systémologie" />
    <meta property="og:description" content="Des constellations familiales et systémiques dans un cadre clair, profond et humain." />
    <meta property="og:url" content="https://lasystemologie.com/" />
    <meta property="og:image" content="https://lasystemologie.com/logo-systemologie.png" />
    <meta property="og:site_name" content="Systémologie" />
    <meta property="og:locale" content="fr_CH" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Constellations familiales et systémiques | Systémologie" />
    <meta name="twitter:description" content="Des constellations familiales et systémiques dans un cadre clair, profond et humain." />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://lasystemologie.com/#organization",
            "name": "Systémologie",
            "url": "https://lasystemologie.com",
            "logo": "https://lasystemologie.com/logo-systemologie.png",
            "description": "Constellations familiales et systémiques, en ligne et en présentiel.",
            "email": "info@lasystemologie.com",
            "address": { "@type": "PostalAddress", "addressLocality": "Genève", "addressCountry": "CH" },
            "founder": [
              { "@type": "Person", "name": "Caroline Verdier", "url": "https://lasystemologie.com/caroline" },
              { "@type": "Person", "name": "Eloa Alvarez", "url": "https://lasystemologie.com/eloa" }
            ],
            "knowsAbout": "Constellations familiales et systémiques"
          },
          {
            "@type": "WebSite",
            "@id": "https://lasystemologie.com/#website",
            "name": "Systémologie",
            "url": "https://lasystemologie.com",
            "publisher": { "@id": "https://lasystemologie.com/#organization" }
          },
          {
            "@type": "Service",
            "name": "Karma Reset à Genève",
            "description": "Journée de constellations familiales et systémiques en groupe à Genève.",
            "provider": { "@id": "https://lasystemologie.com/#organization" },
            "areaServed": { "@type": "City", "name": "Genève" }
          },
          {
            "@type": "Service",
            "name": "Constellation familiale en ligne",
            "description": "Constellation familiale en visio avec un groupe de représentant·es.",
            "provider": { "@id": "https://lasystemologie.com/#organization" }
          },
          {
            "@type": "Service",
            "name": "Constellation sur l'eau",
            "description": "Constellation en visio individuelle avec le support de l'eau.",
            "provider": { "@id": "https://lasystemologie.com/#organization" }
          }
        ]
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Accueil Systémologie">
        <img src="/logo-systemologie-white.png" alt="Systémologie" />
      </a>
      <nav class="desktop-nav" aria-label="Navigation principale">
        <a href="/a-propos">À propos</a>
        <a href="/karma-reset">Karma Reset</a>
        <a href="/constellation-en-ligne">En ligne</a>
        <a href="/constellations-sur-leau">Sur l'eau</a>
      </nav>
      <a class="header-cta" href="https://systemologie.kneo.me/catalog/list" target="_blank" rel="noopener noreferrer">Réserver</a>
    </header>

    <main id="top">
      <div class="section-bg-dark hero-page-bg">
        <section class="hero section-shell">
          <div class="hero-copy">
            <p class="eyebrow">Constellations familiales et systémiques</p>
            <h1>Voir ce qui agit en silence.</h1>
            <p class="hero-text">
              Des constellations familiales et systémiques dans un cadre clair, profond et humain, pour rendre visibles les liens invisibles qui nous traversent.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#formats">Découvrir les formats</a>
              <a class="button secondary" href="/a-propos">À propos de Systémologie</a>
            </div>
          </div>
          <div class="hero-constellation">
            <img src="/gemini-constellation.svg" alt="Constellation des Gémeaux" loading="eager" />
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="formats section-shell" id="formats">
          <div class="section-heading">
            <p class="eyebrow">Les formats</p>
            <h2>Plusieurs manières d'explorer les dynamiques familiales et systémiques.</h2>
            <p>Systémologie propose plusieurs formats pour explorer les dynamiques familiales et systémiques : en groupe, en ligne ou à travers le support de l'eau.</p>
          </div>
          <div class="format-grid">
            {formats.map((format) => (
              <article class="format-card">
                <div>
                  <h3>{format.title}</h3>
                  <p>{format.text}</p>
                </div>
                <a href={format.href}>{format.cta}</a>
              </article>
            ))}
          </div>
        </section>
      </div>

      <div class="section-bg-violet">
        <section class="pillars section-shell">
          <div class="section-heading">
            <p class="eyebrow">Notre approche</p>
            <h2>Un cadre profond, sans devenir flou.</h2>
            <p>Systémologie aborde les constellations comme un outil expérientiel, dans un cadre clair, humain et responsable.</p>
            <p>L'intention n'est pas de produire une explication définitive, ni de chercher des coupables, mais de rendre visibles les dynamiques qui agissent souvent en silence : répétitions, transmissions, exclusions, loyautés, places prises trop tôt ou charges portées pour d'autres.</p>
          </div>
          <div class="pillar-grid">
            <article>
              <span>01</span>
              <h3>Cadre</h3>
              <p>Un espace clair, posé et sécurisant, pour que l'expérience puisse se vivre sans confusion.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Responsabilité</h3>
              <p>Regarder les places, les liens et ce qui peut être rendu à chacun, sans renforcer les positions de victime.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Simplicité</h3>
              <p>Aller à l'essentiel de ce qui se montre, sans interprétation excessive ni narration mentale.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Intégration</h3>
              <p>Chercher un mouvement juste et intégrable, qui peut continuer à se déposer après la séance.</p>
            </article>
          </div>
        </section>
      </div>

      <div class="section-bg-dark">
        <section class="guides section-shell split">
          <div>
            <p class="eyebrow">Caroline & Eloa</p>
            <h2>Deux présences pour tenir un espace vivant et structuré.</h2>
          </div>
          <div class="guide-card">
            <div class="portraits">
              <img src="/portrait-caroline.png" alt="Portrait de Caroline" loading="lazy" />
              <img src="/portrait-eloa.png" alt="Portrait d'Eloa" loading="lazy" />
            </div>
            <p>Systémologie est portée par Caroline et Eloa, toutes deux formées aux constellations familiales et systémiques.</p>
            <p>Leur accompagnement réunit intuition, précision, structure et écoute du champ. L'espace est tenu avec exigence, simplicité et humanité, pour permettre à ce qui doit être vu d'apparaître sans forcer l'interprétation.</p>
            <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px;">
              <a class="button primary" href="/caroline">Découvrir Caroline</a>
              <a class="button secondary" href="/eloa">Découvrir Eloa</a>
            </div>
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="testimonials section-shell" id="testimonials">
          <div class="section-heading">
            <p class="eyebrow">Témoignages</p>
            <h2>Ce que les participant·es en disent.</h2>
          </div>
          <div class="testimonial-grid">
            {testimonials.map((testimonial) => (
              <figure>
                <blockquote>"{testimonial.quote}"</blockquote>
                <figcaption>{testimonial.author}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      </div>

      <div class="section-bg-violet">
        <section class="section-shell narrow" style="text-align: center;">
          <p class="eyebrow">Choisir le format le plus juste</p>
          <h2 style="max-width: 760px; margin: 0 auto 18px;">Entrer dans le travail de constellation.</h2>
          <p style="color: rgba(254, 252, 243, 0.7); margin: 0 auto 34px; max-width: 680px;">
            Systémologie propose trois manières d'entrer dans le travail de constellation : en groupe à Genève, en groupe en ligne, ou en individuel avec le support de l'eau.
          </p>
          <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a class="button primary" href="/karma-reset">Karma Reset à Genève</a>
            <a class="button secondary" href="/constellation-en-ligne">Constellations en ligne</a>
            <a class="button secondary" href="/constellations-sur-leau">Constellations sur l'eau</a>
          </div>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-name">Systémologie</p>
          <p>Constellations familiales et systémiques, Genève & en ligne.</p>
        </div>
        <div class="footer-links">
          <a href="https://lasystemologie.com/">lasystemologie.com</a>
          <a href="mailto:info@lasystemologie.com">info@lasystemologie.com</a>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/cgv">CGV</a>
        </div>
      </div>
    </footer>
  </body>
</html>
