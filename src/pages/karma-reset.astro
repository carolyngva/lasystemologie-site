---
import '../styles/global.css';
import '../styles/design-system.css';

const bookingHref = 'https://systemologie.kneo.me/catalog/list';

const dates = [
  { date: '3 octobre 2026', theme: 'Amour & Couple', text: "Regarder les schémas relationnels, les conflits dans le couple et ce qui empêche l'amour de circuler librement.", href: 'https://systemologie.kneo.me/shop/view/KE34C11F' },
  { date: '14 novembre 2026', theme: 'Argent', text: "Explorer ce qui se joue autour de la sécurité, de la dette, du manque, de la réussite ou de l'autorisation à recevoir.", href: 'https://systemologie.kneo.me/shop/view/X3F34476' },
  { date: '5 décembre 2026', theme: 'Famille', text: 'Remettre de la clarté dans les liens, les conflits entre membres de la famille, les places, les exclusions et les loyautés invisibles.', href: 'https://systemologie.kneo.me/shop/view/MFE1DD50' },
  { date: '9 janvier 2027', theme: 'Vie pro', text: "Regarder la place dans le monde, face à l'autorité, l'engagement, et les répétitions qui traversent ton rapport au travail.", href: 'https://systemologie.kneo.me/shop/view/E2272F59' },
  { date: '6 février 2027', theme: 'Amour & Couple', text: "Regarder les schémas relationnels, les conflits dans le couple et ce qui empêche l'amour de circuler librement.", href: 'https://systemologie.kneo.me/shop/view/A98AC665' },
  { date: '6 mars 2027', theme: 'Argent', text: "Explorer ce qui se joue autour de la sécurité, de la dette, du manque, de la réussite ou de l'autorisation à recevoir.", href: 'https://systemologie.kneo.me/shop/view/C21AE429' },
  { date: '3 avril 2027', theme: 'Famille', text: 'Remettre de la clarté dans les liens, les conflits entre membres de la famille, les places, les exclusions et les loyautés invisibles.', href: 'https://systemologie.kneo.me/shop/view/O5027ADC' },
  { date: '1 mai 2027', theme: 'Vie pro', text: "Regarder la place dans le monde, face à l'autorité, l'engagement, et les répétitions qui traversent ton rapport au travail.", href: 'https://systemologie.kneo.me/shop/view/O395B45D' },
  { date: '5 juin 2027', theme: 'Thème libre / nouveau départ', text: "Venir avec le sujet qui appelle le plus ton attention, faire le point sur ce qui a bougé pendant l'année et ouvrir un nouveau mouvement.", href: 'https://systemologie.kneo.me/shop/view/D57D4A6A' },
];

const themes = [
  { title: 'Amour & Couple', text: "Regarder les schémas relationnels, les conflits dans le couple et ce qui empêche l'amour de circuler librement." },
  { title: 'Argent', text: "Explorer ce qui se joue autour de la sécurité, de la dette, du manque, de la réussite ou de l'autorisation à recevoir." },
  { title: 'Famille', text: 'Remettre de la clarté dans les liens, les conflits entre membres de la famille, les places, les exclusions et les loyautés invisibles.' },
  { title: 'Vie pro', text: "Regarder la place dans le monde, face à l'autorité, l'engagement, et les répétitions qui traversent ton rapport au travail." },
];

const testimonials = [
  { quote: "Cette journée m'a révélé plusieurs choses sur moi, ma vie, où j'en suis et où je vais. Des aspects de mon passé et de mes ancêtres ont été évoqués, ce qui m'éclaire sur mon comportement et mes choix.", author: 'T.S' },
  { quote: "J'ai fait une constellation familiale sans trop savoir à quoi m'attendre. J'y ai compris des choses que je portais depuis longtemps, sans avoir besoin de longues explications.", author: 'Sonia' },
  { quote: 'Je me suis sentie bien accompagnée, en sécurité. Vous nous faites nous sentir en confiance.', author: 'Jennifer' },
  { quote: "J'ai pris conscience que le blocage ne vient pas forcément de là où je l'attends. Je suis heureuse de l'apaisement ressenti face à certains de mes ancêtres.", author: 'Participante' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Karma Reset — Journées de constellations familiales à Genève | Systémologie</title>
    <meta name="description" content="Karma Reset : des journées de constellations familiales à Genève pour explorer les répétitions, les transmissions et les places qui traversent ta vie." />
    <link rel="canonical" href="https://lasystemologie.com/karma-reset/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Karma Reset — Journées de constellations familiales à Genève | Systémologie" />
    <meta property="og:description" content="Des journées de constellations familiales à Genève pour voir ce qui se répète et retrouver ta juste place." />
    <meta property="og:url" content="https://lasystemologie.com/karma-reset/" />
    <meta property="og:image" content="https://lasystemologie.com/logo-systemologie.png" />
    <meta property="og:site_name" content="Systémologie" />
    <meta property="og:locale" content="fr_CH" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Karma Reset — Journées de constellations familiales à Genève" />
    <meta name="twitter:description" content="Voir ce qui se répète. Retrouver ta juste place." />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://lasystemologie.com/#organization",
            "name": "Systémologie",
            "url": "https://lasystemologie.com",
            "logo": "https://lasystemologie.com/logo-systemologie.png",
            "email": "info@lasystemologie.com",
            "address": { "@type": "PostalAddress", "addressLocality": "Genève", "addressCountry": "CH" },
            "founder": [
              { "@type": "Person", "name": "Caroline Verdier", "url": "https://lasystemologie.com/caroline" },
              { "@type": "Person", "name": "Eloa Alvarez", "url": "https://lasystemologie.com/eloa" }
            ],
            "knowsAbout": "Constellations familiales et systémiques"
          },
          {
            "@type": "Service",
            "name": "Karma Reset à Genève",
            "description": "Journées de constellations familiales et systémiques en groupe à Genève.",
            "provider": { "@id": "https://lasystemologie.com/#organization" },
            "areaServed": { "@type": "City", "name": "Genève" }
          }
        ]
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.png" />
    <style is:inline>
      .kr-hero {
        position: relative;
        display: grid;
        align-items: center;
        grid-template-columns: minmax(0, 1.1fr) minmax(200px, 0.9fr);
        gap: 56px;
        padding-top: 120px;
        padding-bottom: 110px;
        overflow: hidden;
      }
      .kr-hero-fleur {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(1100px, 100%);
        aspect-ratio: 1;
        background: url('/fleurdevieindigo.webp') center / contain no-repeat;
        opacity: 0.2;
        pointer-events: none;
        z-index: 0;
        filter: brightness(1.35) saturate(0.9);
        transform: translate(-50%, -50%);
      }
      .kr-hero-text,
      .kr-hero-visual {
        position: relative;
        z-index: 2;
      }
      .kr-hero-text h1 {
        font-size: clamp(2.4rem, 5vw, 4.2rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        max-width: 760px;
        margin-bottom: 16px;
      }
      .kr-hero-text p {
        color: rgba(254, 252, 243, 0.7);
        font-size: 1.15rem;
        line-height: 1.6;
        max-width: 620px;
      }
      .kr-hero-visual img {
        width: 100%;
        max-width: 360px;
        height: auto;
        margin: 0 auto;
        opacity: 0.9;
      }
      .kr-card-grid,
      .date-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .date-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .date-card {
        min-height: 300px;
      }
      .date-card:nth-child(3n + 1) {
        border-top: 3px solid var(--or-solaire);
      }
      .date-card:nth-child(3n + 2) {
        border-top: 3px solid var(--ardoise);
      }
      .date-card:nth-child(3n) {
        border-top: 3px solid var(--violet-profond);
      }
      .date-card .date {
        color: var(--or-solaire);
        font-size: 0.88rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      @media (max-width: 900px) {
        .kr-hero,
        .kr-card-grid,
        .date-grid {
          grid-template-columns: 1fr;
        }
        .kr-hero {
          padding-top: 90px;
        }
        .kr-hero-visual img {
          max-width: 260px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Accueil Systémologie">
        <img src="/logo-systemologie-white.png" alt="Systémologie" />
      </a>
      <nav class="desktop-nav" aria-label="Navigation principale">
        <a href="/a-propos">À propos</a>
        <a href="/karma-reset">Karma Reset</a>
        <a href="/constellation-en-ligne">En ligne</a>
        <a href="/constellations-sur-leau">Sur l'eau</a>
      </nav>
      <a class="header-cta" href="https://systemologie.kneo.me/catalog/list" target="_blank" rel="noopener noreferrer">Réserver</a>
    </header>

    <main>
      <div class="section-bg-dark">
        <section class="kr-hero section-shell">
          <div class="kr-hero-fleur"></div>
          <div class="kr-hero-text">
            <p class="eyebrow">Karma Reset</p>
            <h1>Voir ce qui se répète. Retrouver ta juste place.</h1>
            <p>Des journées de constellations familiales à Genève pour explorer les répétitions qui traversent ta vie, remettre de la clarté dans ton système et ouvrir un mouvement plus juste.</p>
            <p>Chaque journée accueille 5 personnes maximum pour être constellées.</p>
            <div class="hero-actions">
              <a class="button primary" href="#dates">Voir les dates</a>
              <a class="button secondary" href="#deroule">Comment se déroule une journée ?</a>
            </div>
          </div>
          <div class="kr-hero-visual">
            <img src="/gemini-constellation.svg" alt="Constellation des Gémeaux" loading="eager" />
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="section-shell narrow">
          <p class="eyebrow" style="text-align: center;">Le cycle</p>
          <h2 style="text-align: center; max-width: 760px; margin: 0 auto 48px;">Des journées autonomes, reliées par un même fil.</h2>
          <div class="body-copy" style="max-width: 760px; margin: 0 auto;">
            <p>Karma Reset est un cycle de journées de constellations familiales et systémiques en présentiel à Genève.</p>
            <p>Chaque journée part d'un thème concret : l'amour, l'argent, la famille, la vie professionnelle ou un sujet libre en fin d'année.</p>
            <p>Ces thèmes ne sont pas séparés. Ce sont des clés de lecture du système. Ils permettent de regarder, sous différents angles, ce qui se répète, ce qui a été transmis, la place que tu occupes, et ce qui peut être libéré.</p>
            <p>Tu peux venir à une seule journée, parce qu'un thème résonne avec ce que tu traverses maintenant. Tu peux aussi revenir plusieurs fois, pour explorer ton système plus en profondeur et laisser le travail se déposer dans la durée.</p>
            <p class="price" style="font-size: 1.45rem; margin-top: 32px;">Voir ce qui se répète, reconnaître ce qui a été transmis, remettre chacun à sa place et laisser se libérer ce qui n'a plus besoin d'être porté.</p>
          </div>
        </section>
      </div>

      <div class="section-bg-violet">
        <section class="section-shell">
          <div class="section-heading">
            <p class="eyebrow">Les thèmes Karma Reset</p>
            <h2>Quatre clés de lecture pour explorer ton système.</h2>
            <p>Chaque journée est autonome. Tu peux choisir le thème qui t'appelle, ou suivre plusieurs journées pour observer comment les mêmes dynamiques peuvent se manifester dans différents espaces de ta vie.</p>
          </div>
          <div class="kr-card-grid">
            {themes.map((theme) => (
              <article class="offer-panel">
                <h3>{theme.title}</h3>
                <p>{theme.text}</p>
              </article>
            ))}
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="section-shell" id="dates">
          <div class="section-heading">
            <p class="eyebrow">Calendrier 2026-2027</p>
            <h2>Choisir la journée qui t'appelle.</h2>
          </div>
          <div class="date-grid">
            {dates.map((day) => (
              <article class="format-card date-card">
                <div>
                  <p class="date">{day.date}</p>
                  <h3>{day.theme}</h3>
                  <p>{day.text}</p>
                </div>
                <a href={day.href ?? bookingHref} target="_blank" rel="noopener noreferrer">Réserver</a>
              </article>
            ))}
          </div>
          <div style="margin-top: 38px; text-align: center;">
            <p style="color: var(--ardoise); max-width: 620px; margin: 0 auto 20px;">
              Pour participer comme représentant·e, le même lien est utilisé pour toutes les dates. Il réserve une place pour une seule journée Karma Reset. Si tu veux venir à plusieurs journées, il faut réserver une place par date.
            </p>
            <a class="button primary" href="https://systemologie.kneo.me/shop/view/VAF22143" target="_blank" rel="noopener noreferrer">Réserver une place de représentant·e</a>
          </div>
        </section>
      </div>

      <div class="section-bg-dark">
        <section class="section-shell split">
          <div>
            <p class="eyebrow">Génogramme offert</p>
            <h2>Tu veux aller plus loin sur l'année ?</h2>
          </div>
          <div class="guide-card">
            <p>Si tu réserves 3 journées ou plus en une fois, nous t'offrons la réalisation de ton génogramme.</p>
            <p>Le génogramme est une carte visuelle de ton système familial sur plusieurs générations. Il permet de poser ton histoire à plat, non pas pour l'interpréter ou la dramatiser, mais pour repérer les faits marquants, les places, les exclusions, les répétitions et les transmissions qui traversent ton clan.</p>
            <p>C'est souvent un premier mouvement de clarté en soi : voir d'où tu viens, reconnaître ce qui a été porté avant toi, et arriver en constellation avec une lecture plus fine de ton système.</p>
            <a class="button secondary" href={bookingHref} target="_blank" rel="noopener noreferrer">Réserver plusieurs journées</a>
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="testimonials section-shell">
          <div class="section-heading">
            <p class="eyebrow">Témoignages</p>
            <h2>Ce que les participant·es en disent.</h2>
          </div>
          <div class="testimonial-grid">
            {testimonials.map((testimonial) => (
              <figure>
                <blockquote>"{testimonial.quote}"</blockquote>
                <figcaption>{testimonial.author}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      </div>

      <div class="section-bg-violet">
        <section class="section-shell narrow" id="deroule">
          <p class="eyebrow" style="text-align: center;">Comment se déroule une journée ?</p>
          <h2 style="text-align: center; max-width: 700px; margin: 0 auto 48px;">Une journée vivante, structurée et tenue.</h2>
          <div class="offer-panel">
            <p>Une journée Karma Reset alterne constellations, temps d'intégration et transmission. Le cadre est clair, mais le rythme reste vivant : les horaires précis s'ajustent selon le déroulé des constellations et l'énergie du groupe.</p>
            <ul>
              <li>9h45 : accueil.</li>
              <li>10h : cercle d'ouverture.</li>
              <li>10h15 : première constellation.</li>
              <li>Suite de la journée : deuxième, troisième, quatrième et cinquième constellations.</li>
              <li>Pause de midi : après la deuxième ou la troisième constellation, selon l'énergie du groupe et la faim.</li>
              <li>Fin de journée : transmission et clôture.</li>
              <li>18h : départ de la salle.</li>
            </ul>
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="section-shell split">
          <div>
            <p class="eyebrow">Ce que comprend ta place</p>
            <h2>Ta place de constellé·e.</h2>
          </div>
          <div class="body-copy">
            <p>En réservant une place de constellé·e, tu viens avec un sujet que tu souhaites explorer pendant la journée.</p>
            <p>Avant la journée, tu reçois un questionnaire préparatoire à remplir et à renvoyer. Il permet de clarifier ton thème et de préparer le travail avec plus de précision.</p>
            <p>Pendant la journée, ton sujet est constellé. Tu participes aussi comme représentant·e dans les constellations des autres personnes, ce qui fait pleinement partie de l'expérience du groupe.</p>
            <p>Ce qui se montre pour les autres peut aussi résonner avec ton propre système. Cette résonance vient souvent approfondir ton expérience de la journée et ouvrir des prises de conscience complémentaires à ta propre constellation.</p>
          </div>
        </section>
      </div>

      <div class="section-bg-dark">
        <section class="section-shell split">
          <div>
            <p class="eyebrow">Infos pratiques</p>
            <h2>Les détails concrets.</h2>
          </div>
          <div class="offer-panel">
            <ul>
              <li>Lieu : Shanti Club, Genève.</li>
              <li>Horaires : 9h45-18h.</li>
              <li>Tarif constellé·e : 120 CHF la journée.</li>
              <li>Places constellé·es : 5 par journée.</li>
              <li>Repas : non inclus.</li>
              <li>Réservation : un lien Kooneo par journée.</li>
              <li>Bonus : génogramme offert si tu réserves 3 journées ou plus en une fois.</li>
            </ul>
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="section-shell narrow" style="text-align: center;">
          <p class="eyebrow">Place de représentant·e</p>
          <h2 style="max-width: 680px; margin: 0 auto 18px;">Représenter : une autre manière de vivre les constellations.</h2>
          <p style="color: var(--ardoise); max-width: 680px; margin: 0 auto 34px;">Si tu aimerais expérimenter une journée Karma Reset, sentir le travail de constellation de l'intérieur et te mettre au service du groupe, tu peux participer comme représentant·e.</p>
          <a class="button primary" href="/representants-karma-reset">Découvrir la place de représentant·e</a>
        </section>
      </div>

      <div class="section-bg-violet">
        <section class="pillars section-shell">
          <div class="section-heading">
            <p class="eyebrow">Cadre Systémologie</p>
            <h2>Un cadre profond, sans devenir flou.</h2>
            <p>Chez Systémologie, nous abordons les constellations comme un outil expérientiel, avec un cadre clair, humain et responsable.</p>
          </div>
          <div class="pillar-grid">
            <article><span>01</span><h3>Places</h3><p>Nous ne cherchons pas des coupables. Nous regardons les places, les liens, les transmissions et ce qui peut être rendu à chacun.</p></article>
            <article><span>02</span><h3>Simplicité</h3><p>Nous ne forçons pas d'interprétation. Nous suivons ce qui est là et disponible, avec précision et respect du rythme de chacun.</p></article>
            <article><span>03</span><h3>Clarté</h3><p>Une constellation peut ouvrir un mouvement, remettre de la clarté et offrir une autre lecture de ce qui insiste dans ta vie.</p></article>
            <article><span>04</span><h3>Responsabilité</h3><p>Une constellation ne remplace pas un suivi thérapeutique, médical ou psychologique.</p></article>
          </div>
        </section>
      </div>

      <div class="section-bg-light">
        <section class="section-shell narrow">
          <p class="eyebrow" style="text-align: center;">À qui s'adresse Karma Reset ?</p>
          <h2 style="text-align: center; max-width: 700px; margin: 0 auto 48px;">Cette journée peut être juste pour toi si...</h2>
          <div class="offer-panel">
            <ul>
              <li>Tu sens qu'un sujet revient dans ta vie malgré ton travail sur toi.</li>
              <li>Tu veux regarder une difficulté autrement, avec le corps, le ressenti et le système.</li>
              <li>Tu as l'impression de porter quelque chose qui ne t'appartient pas entièrement.</li>
              <li>Tu veux remettre de la clarté dans une relation, une place, une transmission ou un blocage.</li>
              <li>Tu es prêt·e à vivre une expérience profonde dans un cadre structuré.</li>
            </ul>
          </div>
        </section>
      </div>

      <section class="faq section-shell narrow" id="faq">
        <p class="eyebrow">FAQ</p>
        <h2>Questions fréquentes.</h2>
        <details><summary>Faut-il venir avec un thème précis ?</summary><p>Oui, si tu réserves une place de constellé·e, tu viens avec un sujet à explorer. Le questionnaire préparatoire t'aidera à le clarifier avant la journée.</p></details>
        <details><summary>Est-ce que je participe aux constellations des autres ?</summary><p>Oui. Pendant la journée, tu peux être représentant·e dans les constellations des autres participant·es. Cela fait partie du travail collectif et peut aussi ouvrir des prises de conscience personnelles.</p></details>
        <details><summary>Est-ce que le repas est inclus ?</summary><p>Non, le repas n'est pas inclus.</p></details>
        <details><summary>Est-ce que je peux venir plusieurs fois ?</summary><p>Oui. Chaque journée est autonome, mais revenir plusieurs fois permet d'explorer ton système à travers plusieurs clés de lecture : amour, argent, famille, vie professionnelle, puis thème libre.</p></details>
        <details><summary>Est-ce que les constellations remplacent une thérapie ?</summary><p>Non. Les constellations familiales sont un outil expérientiel complémentaire. Elles ne remplacent pas un suivi médical, psychologique ou thérapeutique structuré.</p></details>
      </section>

      <div class="section-bg-violet">
        <section class="section-shell narrow" style="text-align: center;">
          <p class="eyebrow">Choisis la journée qui t'appelle</p>
          <h2 style="max-width: 720px; margin: 0 auto 18px;">Voir les dates et réserver.</h2>
          <p style="color: rgba(254, 252, 243, 0.7); max-width: 680px; margin: 0 auto 34px;">Chaque date ouvre une clé de lecture différente. Tu peux venir pour un thème précis, ou choisir plusieurs journées pour laisser le travail se déployer dans la durée.</p>
          <a class="button primary" href="#dates">Voir les dates et réserver</a>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-name">Systémologie</p>
          <p>Constellations familiales et systémiques, Genève & en ligne.</p>
        </div>
        <div class="footer-links">
          <a href="https://lasystemologie.com/">lasystemologie.com</a>
          <a href="mailto:info@lasystemologie.com">info@lasystemologie.com</a>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/cgv">CGV</a>
        </div>
      </div>
    </footer>
  </body>
</html>
